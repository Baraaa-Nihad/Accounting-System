# رابط قاعدة البيانات PostgreSQL
DATABASE_URL="postgresql://school:CHANGE_ME@localhost:5432/school_accounting"

# مفتاح تشفير النسخ الاحتياطية (سري! احفظ نسخة منه خارج الخادم؛ بدونه لا يمكن فتح النسخ)
BACKUP_ENCRYPTION_KEY="change-this-to-a-long-random-secret"

# مجلد تخزين المرفقات والنسخ الاحتياطية
STORAGE_DIR="./storage"

# (اختياري) مجلد أدوات PostgreSQL (pg_dump / pg_restore) إن لم تكن في PATH
# PG_BIN_DIR="/usr/lib/postgresql/16/bin"

# (اختياري) رمز لتشغيل النسخ التلقائي من cron خارجي عبر: npm run backup
# BACKUP_CRON_TOKEN="random-long-token"

# (اختياري) تعطيل مجدول النسخ الداخلي (عند الاعتماد على cron خارجي)
# DISABLE_BACKUP_SCHEDULER="true"

# (اختياري) بيانات المستخدم المدير عند أول تشغيل
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@12345"

# (اختياري) مسار متصفح Chromium لتوليد ملفات PDF على الخادم
# CHROMIUM_PATH="/usr/bin/chromium-browser"

# (اختياري) فرض ملفات تعريف الارتباط الآمنة: true | false (افتراضيًا: تلقائي حسب HTTPS)
# COOKIE_SECURE="true"

# قاعدة بيانات الاختبارات فقط
TEST_DATABASE_URL="postgresql://school:CHANGE_ME@localhost:5432/school_accounting_test"
